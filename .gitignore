# Dependencies
node_modules/
.pnpm-store/

# Env / secrets (templates are committed, real values are not)
.env
.env.*
!.env.template
!.env.example

# Build output
.medusa/
dist/
build/
.next/
out/

# Logs / OS / editor
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Test / automation artifacts (future)
playwright-report/
test-results/
coverage/

# TypeScript incremental build info
*.tsbuildinfo

# Failure-triage eval scenarios are frozen run artifacts, committed with their logs and test-results.
!agents/failure-triage/evals/scenarios/**/*.log
!agents/failure-triage/evals/scenarios/*/test-results/

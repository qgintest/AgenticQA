# Next.js storefront environment. Copy to apps/storefront/.env.local (scripts/init-env.sh).
# Publishable API key — filled in by scripts/get-publishable-key.sh after first backend start.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Browser-facing backend URL (Docker compose overrides this and sets MEDUSA_BACKEND_URL for SSR)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Default region (must be a country in a seeded region: gb, de, dk, se, fr, es, it)
NEXT_PUBLIC_DEFAULT_REGION=dk
NEXT_PUBLIC_BASE_URL=http://localhost:8000
# Optional
NEXT_PUBLIC_STRIPE_KEY=
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

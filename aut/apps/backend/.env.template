# Medusa backend environment. Copy to apps/backend/.env (scripts/init-env.sh).
# In Docker, DATABASE_URL and REDIS_URL are injected by docker-compose.yml.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
REDIS_URL=redis://localhost:6379
JWT_SECRET=__GENERATE__
COOKIE_SECRET=__GENERATE__
AUTH_MFA_ENCRYPTION_KEY=__GENERATE__
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
# Only needed when running the backend on the host instead of Docker:
# DATABASE_URL=postgres://medusa:<password>@localhost:5432/medusa_aut

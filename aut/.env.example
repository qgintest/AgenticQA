# Compose-level variables for aut/docker-compose.yml
# Copy to aut/.env (scripts/init-env.sh does this and generates a password).
POSTGRES_DB=medusa_aut
POSTGRES_USER=medusa
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_PORT=5432
REDIS_PORT=6379
# Seed 50 demo products on startup (idempotent)
SEED_DEMO_PRODUCTS=true
# Local admin user for the AUT (created by scripts/create-admin.sh)
ADMIN_EMAIL=admin@agenticqa.test
ADMIN_PASSWORD=__GENERATE__

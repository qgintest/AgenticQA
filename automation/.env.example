# Copy to automation/.env to override defaults. All values are optional locally.

# Where the AUT is reachable (defaults shown)
AQA_STOREFRONT_URL=http://localhost:8000
AQA_BACKEND_URL=http://localhost:9000
AQA_COUNTRY_CODE=dk

# Parallel workers (default 2; the storefront runs `next dev`, which struggles with more)
AQA_WORKERS=2

# Admin credentials used for test-data setup/cleanup via the Admin API.
# If unset, ADMIN_EMAIL / ADMIN_PASSWORD are read from ../aut/.env.
AQA_ADMIN_EMAIL=
AQA_ADMIN_PASSWORD=

# Deliberately failing scenario (for triage / self-healing demos):
#   off (default) | assertion | locator
AQA_DELIBERATE_FAILURE=off
